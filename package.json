{
  "name": "hollowtest",
  "version": "0.2.0",
  "description": "Find tests that test nothing (JS, TS, Python). Catches tests that cannot fail: no assertions, tautologies, mocked subjects, swallowed errors, unawaited expects.",
  "type": "module",
  "bin": {
    "hollowtest": "bin/hollowtest.js"
  },
  "exports": "./src/index.js",
  "files": [
    "bin",
    "src",
    "skills",
    "hooks",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/analyze.test.js test/analyze-py.test.js test/fix.test.js test/mutate.test.js",
    "self-check": "node bin/hollowtest.js test/analyze.test.js test/mutate.test.js --min-score 95",
    "build:site": "esbuild site/entry.js --bundle --minify --format=iife --platform=browser --target=es2020 --alias:node:path=./site/path-shim.js --outfile=docs/playground.js && node -e \"require('fs').copyFileSync('site/index.html','docs/index.html')\""
  },
  "keywords": [
    "testing",
    "test-quality",
    "mutation-testing",
    "jest",
    "vitest",
    "ai",
    "coding-agents",
    "claude-code",
    "agent-skills",
    "lint"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Jefferson Valandro",
  "dependencies": {
    "@babel/parser": "^7.29.12"
  },
  "homepage": "https://jeffev.github.io/hollowtest/",
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
